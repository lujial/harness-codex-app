{
  "name": "harness-codex-app",
  "productName": "DeepSeek Harness Codex",
  "version": "1.0.0",
  "description": "DeepSeek Harness 的 Codex 风格独立桌面应用（Electron 壳，加载 http://127.0.0.1:3080）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "author": "DSH",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.codex.app",
    "productName": "DeepSeek Harness Codex",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
